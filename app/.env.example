# =========================
# FEATURE FLAGS
# =========================
FEATURE_SOCIAL_FEED=true
FEATURE_LINK_VAULT=true
FEATURE_BOT_ARENA=true
FEATURE_SWITCH_LAB=true
FEATURE_VPS_FORGE=true
FEATURE_GROWTH_CHAMBER=true
FEATURE_PROVIDER_TOOLS=true
FEATURE_ADMIN_TOOLS=true

# =========================
# ROLE / ACCESS DEFAULTS
# =========================
DEFAULT_SIGNUP_ROLE=user
ALLOW_SELF_PROVIDER_SIGNUP=false
ALLOW_SELF_OPERATOR_SIGNUP=false
REQUIRE_ADMIN_PROVIDER_APPROVAL=true
REQUIRE_ADMIN_OPERATOR_APPROVAL=true

# =========================
# SIMULATION / MOCK LABELS
# =========================
ENABLE_SIMULATION_MODE=true
ENABLE_USER_SUPPLIED_MODE=true
SIMULATION_BADGE_TEXT=Simulation
USER_SUPPLIED_BADGE_TEXT=User-Supplied
PLACEHOLDER_INTEGRATION_BADGE_TEXT=Placeholder Integration

# =========================
# RISK GUARDRAILS
# =========================
MAX_DRAWDOWN_PERCENT=65
MAX_DAILY_LOSS_PERCENT=65
DAILY_LOSS_CAUTION_PERCENT=42.25
DISABLE_NEW_ENTRIES_AT_DAILY_LIMIT=true
PAUSE_AUTOMATION_ON_DRAWDOWN_BREACH=true
DISABLE_LADDER_ON_DAILY_LIMIT=true
DOWNGRADE_SCALPING_TO_MONITOR_ON_CAUTION=true

# =========================
# PLATFORM TIERS
# =========================
TIER_CADET_NAME=Cadet
TIER_OPERATOR_NAME=Operator
TIER_SQUADRON_NAME=Squadron
TIER_COMMAND_NAME=Command

TIER_CADET_PRICE=0
TIER_OPERATOR_PRICE=150
TIER_SQUADRON_PRICE=500
TIER_COMMAND_PRICE=0

# =========================
# GROWTH / BADGES / RANKS
# =========================
GROWTH_UNLOCK_PROFIT_SHIELD=10
GROWTH_UNLOCK_LADDER_AUTHORITY=25
GROWTH_UNLOCK_ADAPTIVE_MISSION=50

RANK_1=Initiate
RANK_2=Scout
RANK_3=Runner
RANK_4=Sniper
RANK_5=Captain
RANK_6=Commander
RANK_7=Elite
RANK_8=Covenant
RANK_9=Architect
RANK_10=Apex

